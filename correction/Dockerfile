FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=5000

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY correctionuni.py .

RUN useradd --create-home appuser
USER appuser

EXPOSE 5000
CMD ["python", "correctionuni.py"]
